<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit sensible defaults (dependency versions, plugin config) from Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jacob</groupId>
    <artifactId>openfga-wrapper</artifactId>
    <version>1.0.0</version>
    <name>openfga-wrapper</name>
    <description>A production-quality Spring Boot wrapper service around OpenFGA</description>

    <properties>
        <!-- Compile against Java 17 so the artifact runs on any JDK 17+ (including the local JDK 25) -->
        <java.version>17</java.version>
        <openfga-sdk.version>0.8.1</openfga-sdk.version>
        <!-- Bump Mockito + Byte Buddy so mocking works on newer local JDKs (25/26).
             CI runs on JDK 17 where the defaults would also be fine. -->
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.18.11</byte-buddy.version>
    </properties>

    <dependencies>
        <!-- Core web stack: embedded Tomcat + Spring MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Production-ready endpoints (health, metrics, info) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean validation (@Valid / @NotBlank) for incoming request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Official OpenFGA Java SDK -->
        <dependency>
            <groupId>dev.openfga</groupId>
            <artifactId>openfga-sdk</artifactId>
            <version>${openfga-sdk.version}</version>
        </dependency>

        <!-- Test stack: JUnit 5, Mockito, AssertJ, Spring test support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages the app as an executable fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Allow Byte Buddy (via Mockito) to run on JDK versions it doesn't
                 yet officially recognise, so the test suite runs on newer local JDKs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
